{
  "name": "devtoys-web",
  "private": true,
  "packageManager": "pnpm@11.15.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "check-types": "pnpm typecheck",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "generate:emoji-catalog": "node scripts/generate-emoji-catalog.mjs --write && biome format --write src/features/emoji/functions/emoji-catalog.generated.ts",
    "verify": "pnpm check && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@monaco-editor/react": "^4.7.0",
    "ajv": "^8.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "^5.6.2",
    "crypto-js": "^4.2.0",
    "diff": "^9.0.0",
    "dompurify": "^3.4.12",
    "fast-xml-parser": "^5.10.1",
    "heic-to": "^1.5.2",
    "jose": "^6.2.3",
    "js-yaml": "^5.2.1",
    "jsonpath-plus": "^10.4.0",
    "lucide-react": "^1.24.0",
    "marked": "^18.0.6",
    "mermaid": "^11.16.0",
    "monaco-editor": "^0.53.0",
    "next": "16.3.0",
    "next-themes": "^0.4.6",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "shadcn": "^4.13.0",
    "smol-toml": "^1.7.0",
    "sql-formatter": "^15.8.2",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "xml-formatter": "^3.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@tailwindcss/postcss": "^4.3.2",
    "@types/crypto-js": "^4.2.2",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.1.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "typescript6": "npm:@typescript/typescript6@^6.0.2"
  }
}
